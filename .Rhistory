auto <- read.csv(
"AutoQuote.csv",
na.strings = c("", "NA"),
stringsAsFactors = FALSE
)
# Show the number of rows
nrow(auto)
# Show the number of columns
ncol(auto)
# Show the structure of each variable
str(auto)
### STEP 2
# Count actual NA values for each variable
missing_count <- sapply(auto, function(x) sum(is.na(x)))
# Calculate percentage of actual NA values
missing_percent <- sapply(auto, function(x) mean(is.na(x)) * 100)
# Build the missing-value table
missing_table <- data.frame(
Variable = names(auto),
Missing = missing_count,
Percent_Missing = missing_percent
)
# Sort from most missing to least missing
missing_table <- missing_table[order(-missing_table$Missing), ]
# Display the table
missing_table
### STEP 3
# Identify rows that are exact duplicates of an earlier row
duplicate_rows <- duplicated(auto)
# Count the number of duplicated rows
sum(duplicate_rows)
# Show the first few duplicated rows
auto[duplicate_rows, ][1:5, ]
# Compare
nrow(auto)
nrow(unique(auto))
### STEP 4
# Step 1: Remove observations with any missing values
rows_before_na <- nrow(auto)
clean <- na.omit(auto)
rows_removed_na <- rows_before_na - nrow(clean)
# Step 2: Remove exact duplicate rows
rows_before_duplicates <- nrow(clean)
clean <- unique(clean)
rows_removed_duplicates <- rows_before_duplicates - nrow(clean)
### STEP 5
# Create Indicator: 1 for yes, 0 for no
clean$Indicator <- ifelse(clean$Purchased == "yes", 1, 0)
# Convert the remaining categorical variables to factors
clean$Education <- factor(clean$Education)
clean$Marital <- factor(clean$Marital)
clean$Job <- factor(clean$Job)
clean$Housing <- factor(clean$Housing)
clean$Financed <- factor(clean$Financed)
clean$Month <- factor(clean$Month)
clean$Day_of_week <- factor(clean$Day_of_week)
# Load packages
library(usmap)
library(ggplot2)
# ------------------------------------------------------------
# 1. Import the data
# ------------------------------------------------------------
premiums <- read.csv(file.choose())
# Check that the data imported correctly
head(premiums)
nrow(premiums)
# ------------------------------------------------------------
# 2. Create the U.S. map
# ------------------------------------------------------------
plot_usmap(
data = premiums,
regions = "states",
values = "direct_premium_billions",
labels = TRUE
) +
# Color intensity represents premium amount
scale_fill_continuous(
low = "lightblue",
high = "darkblue",
name = "Direct Premium\n($ Billions)"
) +
# Title and labels
labs(
title = "Direct Premiums by State, 2025",
subtitle = "Darker states represent higher direct premiums"
) +
# Clean up the appearance
theme(
plot.title = element_text(size = 16, face = "bold"),
plot.subtitle = element_text(size = 11),
legend.position = "right"
)
